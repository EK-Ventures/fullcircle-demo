# Service account used by api/join.js to append rows to Google Sheets.
# Create a GCP service account, enable the Sheets API, generate a JSON key,
# and share the target Sheet with the service account's client email
# (Editor access). Set these as Environment Variables in the Vercel
# dashboard for production; for local `vercel dev`, copy this file to
# `.env` and fill in real values.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key, keeping the
# \n escape sequences literal (don't replace them with real newlines).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
